<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>グミレポ - あなたのグミ記録帳</title>
    <style>
        body { font-family: sans-serif; background: #fff5f8; padding: 20px; color: #333; }
        .container { max-width: 500px; margin: 0 auto; background: white; padding: 20px; border-radius: 20px; box-shadow: 0 5px 15px rgba(0,0,0,0.1); }
        h1 { text-align: center; color: #ff69b4; }
        .input-group { margin-bottom: 15px; }
        label { display: block; font-weight: bold; margin-bottom: 5px; font-size: 0.9rem; }
        input, textarea, select { width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 8px; box-sizing: border-box; }
        button { width: 100%; padding: 15px; background: #ff69b4; color: white; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; }
        #reportList { margin-top: 30px; }
        .report-card { border-bottom: 2px solid #ffe4e6; padding: 15px 0; }
        .report-card img { max-width: 100%; border-radius: 10px; margin-bottom: 10px; }
        .stars { color: #ff9500; font-weight: bold; }
    </style>
</head>
<body>

<div class="container">
    <h1>🍬 グミレポ</h1>
    
    <div class="input-group">
        <label>写真を選択</label>
        <input type="file" id="gumiImage" accept="image/*">
    </div>
    <div class="input-group">
        <label>グミの名前</label>
        <input type="text" id="gumiName" placeholder="例：ハリボー ゴールドベア">
    </div>
    <div class="input-group">
        <label>味 (1〜5)</label>
        <select id="tasteScore"><option>5</option><option>4</option><option>3</option><option>2</option><option>1</option></select>
    </div>
    <div class="input-group">
        <label>弾力 (1〜5)</label>
        <select id="textureScore"><option>5</option><option>4</option><option>3</option><option>2</option><option>1</option></select>
    </div>
    <div class="input-group">
        <label>感想</label>
        <textarea id="gumiComment" rows="3" placeholder="どんな味？食感は？"></textarea>
    </div>
    <button onclick="addReport()">レポートを投稿！</button>

    <div id="reportList"></div>
</div>

<script>
    function addReport() {
        const name = document.getElementById('gumiName').value;
        const taste = document.getElementById('tasteScore').value;
        const texture = document.getElementById('textureScore').value;
        const comment = document.getElementById('gumiComment').value;
        const imageFile = document.getElementById('gumiImage').files[0];

        if (!name) return alert("名前を入力してね！");

        const reader = new FileReader();
        reader.onload = function(e) {
            const list = document.getElementById('reportList');
            const card = document.createElement('div');
            card.className = 'report-card';
            card.innerHTML = `
                ${e.target.result ? `<img src="${e.target.result}">` : ''}
                <h3>${name}</h3>
                <p>味: <span class="stars">${'★'.repeat(taste)}</span> 弾力: <span class="stars">${'★'.repeat(texture)}</span></p>
                <p>${comment}</p>
            `;
            list.prepend(card);
        };
        if (imageFile) reader.readAsDataURL(imageFile);
        else reader.onload({target: {result: null}});
    }
</script>
</body>
</html>
